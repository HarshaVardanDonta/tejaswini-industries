# Local seed only. Path to a Firebase service-account JSON, or the raw JSON string.
# Never commit this file. Not used by the hosted site. Required for `npm run seed:firestore`
# against production. The emulator does not need it.
# FIREBASE_SERVICE_ACCOUNT_JSON=/absolute/path/service-account.json

# Used by the seed script to create the Firebase Auth user and the admins/{uid} allowlist document.
# ADMIN_EMAIL=owner@example.com
# ADMIN_PASSWORD=
