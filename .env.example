VITE_SITE_URL=https://tejaswiniindustries.com

VITE_SANITY_PROJECT_ID=y5p55fqj
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2026-01-01
VITE_SANITY_WRITE_TOKEN=

# Server-only — same Editor token as VITE_SANITY_WRITE_TOKEN; used by /api/contact and /api/quote
SANITY_WRITE_TOKEN=

# Sanity CMS (project already created — do NOT run `sanity init` again)
# 1. Copy this file to .env (project ID is already set for tejaswini-industries)
# 2. Create an Editor API token: https://www.sanity.io/manage/project/y5p55fqj/api
# 3. Paste the token into VITE_SANITY_WRITE_TOKEN above
# 4. Add CORS origin http://localhost:5173 in API settings (same page)
# 5. Run: npm run seed:sanity
# 6. Run: npm run dev → /admin/login (default: admin / changeme)

# Contact form email (server-side only — do NOT prefix with VITE_)
# Used by /api/contact (Vercel) and the Vite dev server middleware.
# Get SMTP settings from your email host (cPanel, Google Workspace, etc.).
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@tejaswiniindustries.com
SMTP_PASS=
SMTP_FROM=info@tejaswiniindustries.com
CONTACT_INQUIRY_TO=info@tejaswiniindustries.com
