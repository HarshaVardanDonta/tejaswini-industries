{
  "name": "tejaswini-industries",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-content.mjs && vite",
    "prebuild": "node scripts/build-content.mjs",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "build:pages": "VITE_BASE_PATH=/tejaswini-industries/ VITE_SITE_URL=https://harshavardandonta.github.io/tejaswini-industries npm run build && cp dist/index.html dist/404.html",
    "lint": "eslint .",
    "preview": "vite preview",
    "seed:firestore": "node scripts/seed-firestore.mjs",
    "emulators": "firebase emulators:start --only auth,firestore --project tejaswini-industries-32349"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "firebase": "^13.1.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@google/stitch-sdk": "^0.3.5",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.34.1",
    "globals": "^17.6.0",
    "react-is": "^19.2.6",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
