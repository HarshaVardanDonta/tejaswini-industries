{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "tejaswiniindustries.com" }],
      "destination": "https://www.tejaswiniindustries.com/",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "tejaswiniindustries.com" }],
      "destination": "https://www.tejaswiniindustries.com/:path",
      "permanent": true
    },
    { "source": "/index.html", "destination": "/", "permanent": true },
    {
      "source": "/products/power-transformers",
      "destination": "/products/distribution-transformers",
      "permanent": true
    },
    {
      "source": "/products/copper-wound-transformers",
      "destination": "/products/distribution-transformers",
      "permanent": true
    },
    {
      "source": "/products/aluminium-wound-transformers",
      "destination": "/products/distribution-transformers",
      "permanent": true
    },
    {
      "source": "/products/crgo-core-transformers",
      "destination": "/products/distribution-transformers",
      "permanent": true
    },
    {
      "source": "/products/amorphous-core-transformers",
      "destination": "/products/distribution-transformers",
      "permanent": true
    },
    {
      "source": "/products/oil-cooled-transformers",
      "destination": "/products/distribution-transformers",
      "permanent": true
    },
    {
      "source": "/products/oltc-transformers",
      "destination": "/products/distribution-transformers",
      "permanent": true
    },
    { "source": "/(.*)/index.html", "destination": "/$1", "permanent": true }
  ],
  "headers": [
    {
      "source": "/admin",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/admin/:path(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
